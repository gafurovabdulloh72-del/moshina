{
  "name": "safar",
  "version": "2.0.0",
  "private": true,
  "description": "SAFAR — brauzerda ishlaydigan 3D sayohat o'yini (Three.js, bitta HTML fayl)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "test": "node tools/veh_test.mjs && node tools/steer_test.mjs",
    "test:roads": "node tools/sim.mjs",
    "test:anim": "node tools/anim_test.mjs",
    "test:smoke": "node tools/shot.mjs tools/s_smoke.js",
    "test:real": "NO_TEST=1 node tools/shot.mjs tools/s_real.js",
    "test:hud": "NO_TEST=1 node tools/shot.mjs tools/s_hud.js",
    "test:adapt": "node tools/shot.mjs tools/s_adapt.js",
    "test:save": "node tools/shot.mjs tools/s_save.js",
    "test:browser": "npm run test:smoke && npm run test:real && npm run test:hud && npm run test:adapt && npm run test:save && npm run test:life && npm run test:life2 && npm run test:world && npm run test:hafta && npm run test:life3 && npm run test:suv && npm run test:tryuk && npm run test:qulay && npm run test:poyga && npm run test:sir && npm run test:kurash && npm run test:daromad",
    "test:api": "node --test tools/api_test.mjs",
    "test:online": "node tools/coop_test.mjs",
    "dev": "node tools/dev-server.mjs",
    "test:life": "node tools/shot.mjs tools/s_life.js",
    "test:life2": "node tools/shot.mjs tools/s_life2.js",
    "test:world": "node tools/shot.mjs tools/s_dunyo.js",
    "test:hafta": "node tools/shot.mjs tools/s_hafta.js",
    "test:life3": "node tools/shot.mjs tools/s_life3.js",
    "test:suv": "node tools/shot.mjs tools/s_suv.js",
    "test:tryuk": "node tools/shot.mjs tools/s_tryuk.js",
    "test:qulay": "node tools/shot.mjs tools/s_qulay.js",
    "test:poyga": "node tools/shot.mjs tools/s_poyga.js",
    "test:sir": "node tools/shot.mjs tools/s_sir.js",
    "test:kurash": "node tools/shot.mjs tools/s_kurash.js",
    "test:daromad": "node tools/shot.mjs tools/s_daromad.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "peerjs": "^1.5.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "peer": "^1.0.2",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5"
  }
